diff --git a/css/car.css b/css/car.css
new file mode 100644
index 0000000..461bc4e
--- /dev/null
+++ b/css/car.css
@@ -0,0 +1,127 @@
+/* The Car Manual: blue theme. Loaded only by car-manual.html, after style.css. */
+:root.car {
+  --bg: #070a0f;
+  --bg2: #0d1219;
+  --bg3: #131a24;
+  --bg4: #1b2430;
+  --card: #0f151d;
+  --border: rgba(160,190,255,0.10);
+  --border2: rgba(160,190,255,0.20);
+  --text: #e9eef5;
+  --gold: #3b82f6;      /* the site's accent variable, now blue on this page */
+  --gold2: #6aaeff;
+  --c-brz: #4da3ff;
+  --c-evo: #a99bff;
+  --c-mx5: #2dd4bf;
+  --c-ek9: #e2e8f0;
+}
+:root.car[data-theme="light"] {
+  --bg: #f1f5fa;
+  --bg2: #e6ecf4;
+  --bg3: #dae3ee;
+  --bg4: #ccd8e6;
+  --card: #ffffff;
+  --border: rgba(10,30,70,0.10);
+  --border2: rgba(10,30,70,0.20);
+  --text: #0e1622;
+  --text2: #3f4b5c;
+  --text3: #5d6a7c;
+  --gold: #1d5fb8;
+  --gold2: #174c96;
+  --c-brz: #1d6fd0;
+  --c-evo: #5b46d6;
+  --c-mx5: #0d7a6e;
+  --c-ek9: #334155;
+}
+
+/* swap the orange/gold hard-coded in style.css for blue */
+.car .hero-track {
+  background:
+    radial-gradient(ellipse 120% 60% at 50% 80%, rgba(59,130,246,0.10) 0%, transparent 60%),
+    radial-gradient(ellipse 80% 40% at 20% 50%, rgba(77,163,255,0.06) 0%, transparent 50%),
+    radial-gradient(ellipse 80% 40% at 80% 50%, rgba(169,155,255,0.06) 0%, transparent 50%);
+}
+.car .speed-line { background: linear-gradient(90deg, transparent, rgba(106,174,255,0.35), transparent); }
+.car .back-to-top:hover { background: rgba(59,130,246,0.12); }
+.car nav { background: rgba(7,10,15,0.95); }
+:root.car[data-theme="light"] nav { background: rgba(241,245,250,0.92); }
+.car .hero-title span.gold { color: var(--gold2); }
+:root.car[data-theme="light"] .hero-title span.gold { color: var(--gold); }
+
+/* "The Racing Manual" link on this page keeps the racing gold */
+nav > a.nav-car.nav-rm { border-color: #d4a017; color: #f0c040; }
+nav > a.nav-car.nav-rm:hover { background: rgba(212,160,23,0.14); color: #fff; border-color: #f0c040; }
+:root.car[data-theme="light"] nav > a.nav-car.nav-rm { border-color: #8b5e00; color: #7a5200; }
+
+/* hero badges */
+.badge-brz  { border-color: var(--c-brz); color: var(--c-brz); }
+.badge-evo  { border-color: var(--c-evo); color: var(--c-evo); }
+.badge-mx5  { border-color: var(--c-mx5); color: var(--c-mx5); }
+.badge-ek9  { border-color: var(--c-ek9); color: var(--c-ek9); }
+.badge-more { border-color: var(--gold2); color: var(--gold2); }
+
+/* the four cars */
+.cm-car-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
+.cm-car {
+  background: var(--card);
+  border: 1px solid var(--border);
+  border-top: 3px solid var(--car);
+  border-radius: 12px;
+  padding: 1.75rem;
+}
+.cm-car-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.9rem; letter-spacing: 0.03em; line-height: 1.05; color: var(--car); font-weight: 400; }
+.cm-car-tag { font-size: 0.78rem; color: var(--text3); margin: 0.3rem 0 0.9rem; }
+.cm-car-note { font-size: 0.9rem; color: var(--text2); margin-bottom: 1.1rem; }
+.cm-specs { margin: 0 0 1.1rem; border-top: 1px solid var(--border); }
+.cm-spec { display: grid; grid-template-columns: 5.5rem 1fr; gap: 0.75rem; padding: 0.55rem 0; border-bottom: 1px solid var(--border); font-size: 0.86rem; }
+.cm-spec dt { color: var(--text3); }
+.cm-spec dd { margin: 0; color: var(--text); }
+.cm-line { font-size: 0.9rem; color: var(--text2); margin-top: 0.6rem; }
+.cm-line b, .cm-see b, .cm-ru b, .cm-best b, .cm-weak b { color: var(--text); font-weight: 600; }
+
+/* basics */
+.cm-topic-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
+.cm-topic { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; }
+.cm-topic:last-child { grid-column: 1 / -1; }
+.cm-topic h3 { font-size: 1.05rem; font-weight: 600; margin-bottom: 0.6rem; color: var(--gold2); }
+:root.car[data-theme="light"] .cm-topic h3 { color: var(--gold); }
+.cm-topic p { font-size: 0.9rem; color: var(--text2); }
+.cm-see { margin-top: 0.85rem; padding-top: 0.85rem; border-top: 1px solid var(--border); font-size: 0.84rem !important; }
+
+/* advanced */
+#advanced .era-block a { color: var(--gold2); }
+
+/* verdict */
+.cm-award-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
+.cm-award { background: var(--card); border: 1px solid var(--border); border-left: 3px solid var(--gold); border-radius: 12px; padding: 1.5rem; }
+.cm-award-cat { font-size: 0.82rem; color: var(--text3); margin-bottom: 0.35rem; }
+.cm-award h3 { font-family: 'Bebas Neue', sans-serif; font-size: 1.6rem; letter-spacing: 0.03em; font-weight: 400; color: var(--gold2); line-height: 1.1; margin-bottom: 0.5rem; }
+:root.car[data-theme="light"] .cm-award h3 { color: var(--gold); }
+.cm-award p { font-size: 0.88rem; color: var(--text2); }
+.cm-ru { margin-top: 0.7rem; font-size: 0.82rem !important; }
+
+/* more cars */
+.cm-extra-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
+.cm-extra { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; }
+.cm-extra h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem; }
+.cm-extra p { font-size: 0.88rem; color: var(--text2); margin-top: 0.5rem; }
+.cm-best { color: var(--text) !important; }
+
+.car .compare-table td:first-child { color: var(--text); }
+.car .compare-table td { white-space: normal; }
+.car .compare-table { min-width: 760px; }
+.car .compare-note { margin-top: 1rem; font-size: 0.8rem; color: var(--text3); }
+
+@media (max-width: 1000px) {
+  .cm-topic-grid, .cm-award-grid, .cm-extra-grid { grid-template-columns: repeat(2, 1fr); }
+}
+@media (max-width: 700px) {
+  .cm-car-grid, .cm-topic-grid, .cm-award-grid, .cm-extra-grid { grid-template-columns: 1fr; }
+  .cm-car { padding: 1.4rem; }
+  .cm-spec { grid-template-columns: 4.5rem 1fr; }
+}
+
+/* hero link back to the Racing Manual keeps the racing gold */
+.hero-corner.hero-corner-rm { border-color: #d4a017; color: #f0c040; background: rgba(7,10,15,0.55); }
+.hero-corner.hero-corner-rm:hover { background: rgba(212,160,23,0.18); color: #fff; }
+:root.car[data-theme="light"] .hero-corner.hero-corner-rm { border-color: #8b5e00; color: #7a5200; background: rgba(241,245,250,0.7); }
